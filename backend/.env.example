# Copia este archivo a .env y rellena los valores. .env nunca se sube a git.

# ElevenLabs: API key (solo en el backend) y id del agente
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Secreto compartido con ElevenLabs: se configura como "API key" del Custom LLM
# en el agente y nos llega como "Authorization: Bearer <secreto>".
# Vacío = sin comprobación (solo para pruebas en local).
CUSTOM_LLM_SECRET=

# Orígenes web permitidos (separados por comas): la versión web de GitHub Pages (iPhone).
# Además, ALLOWED_ORIGIN_REGEX deja pasar localhost en cualquier puerto (vacía = ninguno).
# La APK no manda Origin. Si la petición trae un Origin que no está aquí, la API responde 403.
ALLOWED_ORIGINS=https://aliassdev.github.io,http://localhost:5173
# ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# true = registra la estructura de las peticiones del Custom LLM (sin el texto del usuario)
DEBUG_LLM_REQUESTS=true

# LLM (capa 3): cualquier API compatible con OpenAI. Por defecto Groq (gratis: console.groq.com)
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODELO=openai/gpt-oss-120b
# LLM_MODELO_REFORMULAR=openai/gpt-oss-20b
# Juez de «Dilo con tus palabras» (POST /api/learn/grade); por defecto, LLM_MODELO
# LLM_MODELO_EVALUAR=openai/gpt-oss-120b
# Router de inferencia de Hugging Face (lo que usa el Space): LLM_BASE_URL=https://router.huggingface.co/v1 y
# LLM_API_KEY=<token de Hugging Face>. Allí el 120b lo sirve Cerebras (~0,35 s) y el 20b, Groq (~0,47 s).

# LLM de respaldo (opcional): si el principal da 429, 5xx, timeout o fallo de conexión, se prueba este.
# El mismo router con otro proveedor (sin LLM_RESPALDO_API_KEY usa LLM_API_KEY, porque la URL es la misma):
# LLM_RESPALDO_BASE_URL=https://router.huggingface.co/v1
# LLM_RESPALDO_MODELO=openai/gpt-oss-120b:groq
# O Groq directamente, con su propia clave:
# LLM_RESPALDO_BASE_URL=https://api.groq.com/openai/v1
# LLM_RESPALDO_API_KEY=
# LLM_RESPALDO_MODELO=openai/gpt-oss-120b
# Plazos en segundos, contando el respaldo: voz hasta el primer texto, texto completo y reformulación
# LLM_PLAZO_VOZ_S=7
# LLM_PLAZO_TEXTO_S=14
# REFORMULAR_PLAZO_S=2

# Voz (Custom LLM)
# Frase puente («Vale, te lo explico.») nada más pasar el guardrail, mientras se prepara la respuesta
# VOZ_FRASE_PUENTE=true
# Etiquetas de tono entre corchetes ([slow]): false las quita, porque eleven_flash_v2_5 las leería. true solo con eleven_v3
# TTS_ETIQUETAS=false
# Hilos para las peticiones en curso (anyio usa 40)
# HILOS_MAX=100

# Límites de peticiones de /api/session/*, /api/agent/ask y /api/learn/grade (backend/API.md).
# _IP: por IP en una ventana de LIMITE_VENTANA_S segundos. _DIA: total para todos (00:00 UTC). 0 = sin límite.
# LIMITE_VENTANA_S=60
# LIMITE_SESION_IP=10
# LIMITE_SESION_DIA=200
# LIMITE_ASK_IP=20
# LIMITE_ASK_DIA=1000
# LIMITE_GRADE_IP=20
# LIMITE_GRADE_DIA=1000
# Proxies que añaden una entrada al final de X-Forwarded-For (Hugging Face: 1; sin proxy: 0)
# PROXIES_DE_CONFIANZA=1

# Guardrail (capa 1). Rutas relativas a backend/. Sin modelo entrenado, funciona solo con reglas.
GUARDRAIL_MODELO_DIR=../artifacts/models/guardrail
GUARDRAIL_UMBRAL_CRISIS=0.30
GUARDRAIL_UMBRAL_OTROS=0.50
