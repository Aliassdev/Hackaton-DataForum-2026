# Copia este archivo a .env y rellena los valores. .env nunca se sube a git.

# ElevenLabs: API key (solo en el backend) y id del agente
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Secreto compartido con ElevenLabs: se configura como "API key" del Custom LLM
# en el agente y nos llega como "Authorization: Bearer <secreto>".
# Vacío = sin comprobación (solo para pruebas en local).
CUSTOM_LLM_SECRET=

# Orígenes permitidos para el frontend (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173

# true = registra la estructura de las peticiones del Custom LLM (sin el texto del usuario)
DEBUG_LLM_REQUESTS=true
